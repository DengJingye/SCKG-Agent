{
  "schema_version": "1.0",
  "product": "scKG Local Research Workbench",
  "target": "macOS Apple Silicon Beta",
  "max_release_size_bytes": 524288000,
  "include": [
    ".env.example",
    ".streamlit/config.toml",
    "AGENTS.md",
    "README.md",
    "app.py",
    "requirements.txt",
    "agent",
    "cli",
    "connectors",
    "contracts",
    "core",
    "engine",
    "execution",
    "observability",
    "release",
    "runtime_packs",
    "data/scrna_tools.tsv",
    "data/tool_publications.tsv",
    "data/tool_benchmarks.tsv",
    "data/catalog",
    "data/decision_graph_v3",
    "data/knowledge_graph_v2",
    "data/indexes/evidence_chunks.jsonl",
    "data/indexes/evidence_vectors.jsonl",
    "docs/DEV_SPEC_2.0.md",
    "docs/status",
    "docs/security",
    "docs/product"
  ],
  "exclude_patterns": [
    "**/__pycache__/**",
    "**/*.pyc",
    "**/.DS_Store",
    "**/*.pdf",
    "**/*.h5ad",
    "**/*.pptx",
    ".env",
    ".git/**",
    ".sckg_exec/**",
    ".sckg_user/**",
    "data/evidence_sources/**",
    "data/scKG_embeddings_backup.jsonl",
    "dist/**",
    "logs/**"
  ]
}
