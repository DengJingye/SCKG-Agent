{
  "contract_id": "singler:2.14.0",
  "contract_version": "0.2.0-wrapper-implemented",
  "tool_name": "SingleR",
  "tool_version": "2.14.0",
  "task": "cell_type_annotation",
  "language": "r",
  "environment_id": "annotation-r",
  "wrapper_id": "singler_v2_14_0",
  "input_object": "AnnData",
  "required_fields": [
    "cell-by-gene test expression matrix with stable cell and gene identifiers",
    "explicit reference expression dataset with known labels",
    "normalized and log-transformed reference expression",
    "overlapping genes between test and reference",
    "explicit species and gene identifier mapping"
  ],
  "optional_fields": [
    "test matrix may be untransformed because SingleR scoring uses ranks",
    "cell ontology labels",
    "multiple references"
  ],
  "preconditions": [
    {
      "rule_id": "singler_reference_required",
      "field": "annotation_reference",
      "operator": "exists",
      "expected": true,
      "blocking": true,
      "message": "SingleR requires an explicit reference dataset and label field."
    },
    {
      "rule_id": "singler_gene_overlap",
      "field": "reference_gene_overlap",
      "operator": "gte",
      "expected": 1,
      "blocking": true,
      "message": "Test and reference must share mapped genes."
    },
    {
      "rule_id": "singler_species_known",
      "field": "species",
      "operator": "exists",
      "expected": true,
      "blocking": true,
      "message": "Species must be known before choosing a reference."
    }
  ],
  "not_supported": [
    "missing reference labels",
    "reference expression that is not normalized and log-transformed",
    "test/reference gene identifiers without an explicit mapping",
    "reference species incompatible with the test data",
    "claiming pruned labels are biological ground truth"
  ],
  "output_artifacts": [
    {
      "artifact_id": "singler_predicted_labels",
      "artifact_type": "cell_annotation_table",
      "format": "tsv",
      "required": true,
      "validator_id": "annotation_label_schema_v1"
    },
    {
      "artifact_id": "singler_score_matrix",
      "artifact_type": "annotation_score_matrix",
      "format": "tsv",
      "required": true,
      "validator_id": "annotation_score_schema_v1"
    },
    {
      "artifact_id": "singler_result_metadata",
      "artifact_type": "execution_metadata",
      "format": "json",
      "required": true,
      "validator_id": "annotation_metadata_schema_v1"
    }
  ],
