  "tool_name": "CellTypist",
  "tool_version": "1.7.1",
  "task": "cell_type_annotation",
  "language": "python",
  "environment_id": "annotation-python",
  "wrapper_id": "celltypist_v1_7_1",
  "input_object": "AnnData",
  "required_fields": [
    "cell-by-gene AnnData expression matrix",
    "log1p-normalized expression to 10000 counts per cell in X or raw.X",
    "gene symbols compatible with the selected model",
    "explicit versioned CellTypist model"
  ],
  "optional_fields": [
    "over-clustering labels for majority voting",
    "known organism and tissue context"
  ],
  "preconditions": [
    {
      "rule_id": "celltypist_log1p_to_10k",
      "field": "normalization_target",
      "operator": "in",
      "expected": [
        "ready_log1p_10000"
      ],
      "blocking": true,
      "message": "CellTypist AnnData prediction requires log1p-normalized expression to 10000 counts per cell."
    },
    {
      "rule_id": "celltypist_gene_symbols",
      "field": "gene_identifier_type",
      "operator": "equals",
      "expected": "gene_symbol",
      "blocking": true,
      "message": "Input genes must be symbols compatible with the selected model."
    },
    {
      "rule_id": "celltypist_model_required",
      "field": "annotation_reference",
      "operator": "exists",
      "expected": true,
      "blocking": true,
      "message": "A local versioned CellTypist model must be selected before execution."
    }
  ],
  "not_supported": [
    "scaled expression with negative values",
    "raw AnnData counts passed without deterministic normalization",
    "gene identifiers not mapped to model gene symbols",
    "automatic model download during execution",
    "claiming unknown labels are biologically validated without review"
  ],
  "output_artifacts": [
    {
      "artifact_id": "celltypist_predicted_labels",
      "artifact_type": "cell_annotation_table",
