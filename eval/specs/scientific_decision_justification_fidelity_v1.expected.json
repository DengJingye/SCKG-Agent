      "EXTRA_NON_DECISION_EVIDENCE": "A resolvable citation does not support any frozen scientific atom in its scenario.",
      "SCOPE_MISMATCH": "A resolved scope dimension contradicts the frozen scenario context, including an expected unknown/not_evaluated dimension emitted as incompatible.",
      "SCOPE_SILENTLY_WIDENED": "An unresolved or narrower frozen scope is asserted as compatible without authoritative resolution; specifically, expected unknown/not_evaluated emitted as compatible uses this failure.",
      "REPRESENTATION_LINK_MISSING": "A required concrete record or explicit absence is not linked.",
      "REPRESENTATION_LINK_WRONG": "The explanation links a different record than the one that supports the atom.",
      "EPISTEMIC_STATUS_CONFLATION": "Candidate knowledge is asserted as trusted/canonical or observed state is recast as scientific knowledge."
    }
