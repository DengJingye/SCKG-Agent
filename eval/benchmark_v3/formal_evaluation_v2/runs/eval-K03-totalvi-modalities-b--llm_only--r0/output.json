      {
        "authority": "model_knowledge_unverified",
        "citation_mapping": "not_applicable",
        "claim_id": "claim-001",
        "claim_text": "在您提供的条件下（一个 CITE-seq 批次有 RNA+蛋白，一个 scRNA-seq 批次只有 RNA），totalVI 在方法层面是适配的。",
        "claim_type": "scientific",
        "governance_action": "label_unverified",
        "lexical_support": 0.0,
        "numeric_scope_match": "not_applicable",
        "reasons": [
          "not_scientific_authority"
        ],
        "scope_match": "unknown",
        "semantic_review_status": "not_run",
        "source_span_ids": []
      },
      {
        "authority": "model_knowledge_unverified",
        "citation_mapping": "not_applicable",
        "claim_id": "claim-001",
        "claim_text": "输入要求：RNA 应为 UMI 计数矩阵，蛋白质应为 ADT 计数矩阵；缺失蛋白质的批次在相应位置留空或使用掩码。",
        "claim_type": "input_requirement",
        "governance_action": "label_unverified",
        "lexical_support": 0.0,
        "numeric_scope_match": "not_applicable",
        "reasons": [
