        "citation_mapping": "not_applicable",
        "claim_id": "claim-001",
        "claim_text": "失败模式：如果蛋白质缺失不是完全随机，而是与批次或细胞类型系统相关，模型可能错误地将缺失模式解释为生物信号。",
        "claim_type": "failure_mode",
        "governance_action": "label_unverified",
