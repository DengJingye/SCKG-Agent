        "citation_mapping": "not_applicable",
        "claim_id": "claim-001",
        "claim_text": "条件边界：totalVI 假设缺失蛋白质的细胞与有蛋白质的细胞来自相同的底层生物状态分布；若两个批次细胞类型差异极大，联合嵌入可能不稳定。",
        "claim_type": "scientific",
        "governance_action": "label_unverified",
        "lexical_support": 0.0,
        "numeric_scope_match": "not_applicable",
        "reasons": [
