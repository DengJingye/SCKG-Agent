    {
      "canonical_task": "",
      "chunk_id": "approved-v2:08fdd20a3f2cdfadad2d7934",
      "claim_type": "method",
      "dense_rank": null,
      "governance_status": "approved_scientific_assertion",
      "recommendation_eligible": false,
