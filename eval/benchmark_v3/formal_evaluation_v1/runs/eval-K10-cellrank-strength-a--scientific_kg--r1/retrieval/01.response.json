      {
        "caution_id": "evidence-gap:1b346cd74849e12fde2de5b5",
        "description": "Causality of lineage-correlated genes: Correlation-based putative driver identification is not causal mechanism discovery; experiments/causal inference are additional prospective work.",
        "evidence": [
          {
            "content_hash": "f836bb90e3dacf1a02381273244dcbcaac588f5a9b64135c545654473d358161",
            "end_offset": 43759,
            "evidence_span_id": "evidence-span:546ac5f05fb2b9501f17f9b8",
            "exact_text": "Identifying putative driver genes is another aspect that can be \nextended in future work. Currently, we rank putative driver genes \nby correlating fate probabilities with gene expression. Although this \napproach has proven powerful, as shown in various applications, it is \nsolely based on correlation. To unravel the causal mechanisms link-\ning molecular properties and changes to fate decisions, perturbation \ndata and causal inference71 can be combined with CellRank 2. This \ncombination will ultimately enhance our understanding of underlying \nmolecular drivers.",
            "locator": {
              "kind": "pdf_page",
              "value": "source-artifact:bdddbe8c5972df154c3c6bb79a1e2822/text-sha256:da8d619bee33cb0605615e1128bdeed2caa31467779137b8e6c04474e9ef1e2e:43193:43759"
            },
            "ontology_version": "2.0.0-core-review.1",
            "page": 8,
            "schema_version": "sckg-ontology-core-5c-design-v1",
