      "source_span": "SingleR/R/SingleR.R#L1-L14",
      "sparse_rank": 2,
      "text": "Returns the best annotation for each cell in a test dataset, given a labelled reference dataset in the same feature space. test A numeric matrix of single-cell expression values where rows are genes and columns are cells. ref A numeric matrix of (usually normalized and log-transformed) expression values from a reference dataset.",
      "title": "Authoritative bounded evidence: uat-authoritative-span:singler.interface",
      "tool_name": "SingleR",
      "tool_names": [
