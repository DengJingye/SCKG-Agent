{"id":"WF001_pbmc_multibatch_decision","query":"I have multi-sample 10x PBMC scRNA-seq data and want QC, doublet detection, batch integration, cell type annotation, and optional trajectory analysis.","constraints":{"task":"Workflow Planning","modality":"scRNA-seq","platform":"10x Genomics","species":"Human","data_object":"raw count matrix / AnnData / SeuratObject","scale":"50k-200k cells; multi-sample PBMC","noise":"medium","output_goal":"integrated doublet-filtered annotated PBMC object with optional trajectory review"},"candidate_tools":["Scanpy","Seurat","Scrublet","DoubletFinder","Harmony","scvi-tools","CellTypist","SingleR","scVelo","CellRank"],"expected_step_terms":["qc","doublet","normalization","integration","annotation","trajectory","audit"],"expected_candidate_tools":["Scanpy","Scrublet","Harmony","CellTypist","scVelo"],"allowed_extra_step_terms":["feature","report","evidence","fate"]}
{"id":"WF002_doublet_detection","query":"Detect doublets in droplet-based scRNA-seq before downstream clustering and annotation.","constraints":{"task":"Doublet Detection","modality":"scRNA-seq","platform":"10x Genomics","data_object":"raw count matrix / AnnData","output_goal":"doublet-filtered object and doublet risk report"},"candidate_tools":["Scrublet","DoubletFinder","Scanpy","Seurat"],"expected_step_terms":["input validation","doublet score","threshold","post-filter qc"],"expected_candidate_tools":["Scrublet","DoubletFinder"],"allowed_extra_step_terms":["qc","sample context"]}
