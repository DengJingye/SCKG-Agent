{
  "additionalProperties": false,
  "properties": {
    "allow_missing_modalities": {
      "default": false,
      "title": "Allow Missing Modalities",
      "type": "boolean"
    },
    "constraint_id": {
      "pattern": "^representation-constraint:[a-z0-9][a-z0-9_.:-]{0,126}$",
      "title": "Constraint Id",
      "type": "string"
    },
    "feature_alignment": {
      "default": "not_applicable",
      "enum": [
        "not_applicable",
        "same_features",
        "intersection",
        "explicit_mapping"
      ],
      "title": "Feature Alignment",
      "type": "string"
    },
    "forbidden_transformations": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Forbidden Transformations",
      "type": "array"
    },
    "observation_alignment": {
      "default": "not_applicable",
      "enum": [
        "not_applicable",
        "same_observations",
        "explicit_mapping",
        "paired",
        "partially_paired"
      ],
      "title": "Observation Alignment",
      "type": "string"
    },
    "representation_type_id": {
      "pattern": "^representation-type:",
      "title": "Representation Type Id",
      "type": "string"
    },
    "required_component_roles": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Required Component Roles",
      "type": "array"
    },
    "required_metadata": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Required Metadata",
      "type": "array"
    },
    "required_modalities": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Required Modalities",
      "type": "array"
    },
    "required_provenance_method_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Required Provenance Method Ids",
      "type": "array"
    },
    "required_transformations": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Required Transformations",
      "type": "array"
    },
    "required_value_states": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Required Value States",
      "type": "array"
    },
    "schema_version": {
      "const": "sckg-representation-constraint-v1.1",
      "default": "sckg-representation-constraint-v1.1",
      "enum": [
        "sckg-representation-constraint-v1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "scope_id": {
      "pattern": "^scope:",
      "title": "Scope Id",
      "type": "string"
    }
  },
  "required": [
    "constraint_id",
    "representation_type_id",
    "scope_id"
  ],
  "title": "RepresentationConstraint",
  "type": "object"
}
