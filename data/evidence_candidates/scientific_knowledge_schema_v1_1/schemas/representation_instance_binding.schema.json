      "type": "string"
    },
    "constraint_id": {
      "pattern": "^representation-constraint:",
      "title": "Constraint Id",
      "type": "string"
    },
    "ledger_id": {
      "minLength": 1,
      "title": "Ledger Id",
      "type": "string"
    },
