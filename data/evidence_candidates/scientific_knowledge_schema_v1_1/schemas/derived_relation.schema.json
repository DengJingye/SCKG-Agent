{
  "additionalProperties": false,
  "properties": {
    "derivation_rule_id": {
      "minLength": 1,
      "title": "Derivation Rule Id",
      "type": "string"
    },
    "derivation_type": {
      "enum": [
        "port_projection",
        "reviewed_rule"
      ],
      "title": "Derivation Type",
      "type": "string"
    },
    "derived_from_claim_revision_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Derived From Claim Revision Ids",
      "type": "array"
    },
    "input_port_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Port Id"
    },
    "output_port_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Port Id"
    },
    "premise_relation_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Premise Relation Ids",
      "type": "array"
    },
    "relation": {
      "enum": [
        "CONSUMES",
        "PRODUCES",
        "CAN_FEED",
        "REQUIRES_BEFORE"
      ],
      "title": "Relation",
      "type": "string"
    },
    "relation_id": {
      "pattern": "^derived-relation:",
      "title": "Relation Id",
      "type": "string"
    },
    "requirement_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirement Id"
    },
    "review_decision_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Review Decision Ids",
      "type": "array"
    },
    "review_status": {
      "enum": [
        "candidate_pending_review",
        "accepted",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "schema_version": {
      "const": "sckg-derived-relation-v1.1",
      "default": "sckg-derived-relation-v1.1",
